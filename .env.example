
from typing import TypedDict, Annotated

from speech import speech_to_text

from RAG_Portfolio.llm.groq_llm import GroqLLM
from langchain_core.messages import AIMessage
from langgraph.graph.message import add_messages
from langgraph.graph import StateGraph, START, END

from RAG_Portfolio.retrieval.load_indexes import IndexLoader
from RAG_Portfolio.retrieval.hybrid_retriever import HybridRetriever

from RAG_Portfolio.generation.context_builder import ContextBuilder


# =====================================================
# Load Hybrid RAG
# =====================================================

print("\nLoading Hybrid Retrieval Pipeline...")

indexes = IndexLoader()

hybrid_retriever = HybridRetriever(

    faiss_store=indexes.get_faiss(),

    bm25_store=indexes.get_bm25(),

    top_k=20

)

print("Hybrid Retriever Ready.")

# =====================================================
# LLM
# =====================================================



llm = GroqLLM().get_llm()


# =====================================================
# LangGraph State
# =====================================================

class State(TypedDict):

    query_type: str

    messages: Annotated[list, add_messages]

    retrieved_context: str

# =====================================================
# Classifier Node
# =====================================================

def classifier_node(state: State):

    query = state["messages"][-1].content

    prompt = f"""
You are a routing classifier.

Your job is to classify every user query.

If the answer requires searching indexed documents
such as:

- Resume
- Portfolio
- Books
- PDFs
- Research Papers
- Notes
- Harvard Classics

respond with

RAG

Otherwise respond

GENERAL

Return ONLY one word.

Query:

{query}
"""

    response = llm.invoke(

        [

            ("system", prompt),

            ("human", query)

        ]

    )

    label = response.content.strip().upper()

    if label not in [

        "RAG",

        "GENERAL"

    ]:

        label = "GENERAL"

    return {

        "query_type": label

    }

# =====================================================
# RAG Node
# =====================================================

def rag_node(state: State):

    query = state["messages"][-1].content

    print("\nSearching Documents...")

    documents = hybrid_retriever.retrieve(

        query

    )

    context = ContextBuilder.build(

        documents

    )

    return {

        "retrieved_context": context

    }


# =====================================================
# General LLM Node
# =====================================================

def general_node(state: State):

    return {

        "retrieved_context": "NO_RETRIEVAL"

    }


# =====================================================
# Response Node
# =====================================================

def response_node(state: State):

    query = state["messages"][-1].content

    context = state["retrieved_context"]

    if context == "NO_RETRIEVAL":

        prompt = f"""
You are a helpful AI assistant.

Answer the user's question clearly and accurately.

Question:

{query}
"""

    else:

        prompt = f"""
You are an intelligent AI assistant.

Answer ONLY using the supplied context.

If the answer is not present in the context, reply exactly:

"I couldn't find that information in the provided documents."

----------------------------

Context

{context}

----------------------------

Question

{query}

Answer:
"""

    response = llm.invoke(prompt)

    return {

        "messages": [

            AIMessage(

                content=response.content

            )

        ]

    }


# =====================================================
# Router
# =====================================================

def router_function(state: State):

    if state["query_type"] == "RAG":

        return "rag_node"

    return "general_node"

# =====================================================
# LangGraph
# =====================================================

graph = StateGraph(State)

graph.add_node(

    "classifier_node",

    classifier_node

)

graph.add_node(

    "rag_node",

    rag_node

)

graph.add_node(

    "general_node",

    general_node

)

graph.add_node(

    "response_node",

    response_node

)

graph.add_edge(

    START,

    "classifier_node"

)

graph.add_conditional_edges(

    "classifier_node",

    router_function,

    {

        "rag_node": "rag_node",

        "general_node": "general_node",

    }

)

graph.add_edge(

    "rag_node",

    "response_node"

)

graph.add_edge(

    "general_node",

    "response_node"

)

graph.add_edge(

    "response_node",

    END

)

app = graph.compile()

print("\n==============================================")
print("Production Hybrid RAG Assistant Ready")
print("==============================================")

# =====================================================
# Chat Loop
# =====================================================

while True:

    print("\n1. Text")

    print("2. Voice")

    print("3. Exit")

    choice = input("\n> ")

    if choice == "1":

        user_input = input("\nYou : ")

    elif choice == "2":

        user_input = speech_to_text()

        print("\nYou :", user_input)

    elif choice == "3":

        break

    else:

        print("Invalid Choice")

        continue

    print("\nThinking...")

    result = app.invoke(

        {

            "messages": [

                (

                    "user",

                    user_input

                )

            ]

        }

    )

    print("\nAssistant:\n")

    print(

        result["messages"][-1].content

    )